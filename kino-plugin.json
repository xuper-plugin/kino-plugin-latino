{
  "id": "latino",
  "name": "Latino",
  "version": "2.0.4",
  "apiVersion": 9,
  "panel": {
    "label": "Latino",
    "labelEn": "Latino",
    "iconFile": "panel-icon.png"
  },
  "entry": "plugin.js",
  "icon": "icon.png",
  "description": "Películas y series en español latino, castellano o subtituladas desde varias fuentes",
  "author": "xuper-plugin",
  "homepage": "https://github.com/xuper-plugin/kino-plugin-latino",
  "hosts": [
    "lamovie.org",
    "hackstore2.com",
    "www.cinecalidad.vg",
    "cinecalidad.vg",
    "www3.seriesmetro.net",
    "seriesmetro.net",
    "seriesflixhd.casa",
    "seriesflixhd.best",
    "embed69.org",
    "mg.homelabx.qzz.io",
    "proyectox.yoyatengoabuela.com",
    "goodstream.one",
    "*.goodstream.one",
    "vimeos.net",
    "*.vimeos.net",
    "vimeos.zip",
    "*.vimeos.zip",
    "hlswish.com",
    "*.hlswish.com",
    "streamwish.com",
    "*.streamwish.com",
    "streamwish.to",
    "*.streamwish.to",
    "strwish.com",
    "*.strwish.com",
    "wishembed.com",
    "*.wishembed.com",
    "filelions.com",
    "*.filelions.com",
    "hglink.to",
    "*.hglink.to",
    "vibuxer.com",
    "*.vibuxer.com",
    "vidhide.com",
    "*.vidhide.com",
    "vidhidepro.com",
    "*.vidhidepro.com",
    "dintezuvio.com",
    "*.dintezuvio.com",
    "minochinos.com",
    "*.minochinos.com",
    "filelions.to",
    "*.filelions.to",
    "morencius.com",
    "*.morencius.com",
    "fastream.to",
    "*.fastream.to",
    "voe.sx",
    "*.voe.sx",
    "ok.ru",
    "*.ok.ru",
    "archive.org",
    "*.archive.org",
    "nupload.me",
    "*.nupload.me",
    "nupload.my",
    "*.nupload.my",
    "www.pelisplushd.la",
    "pelisplushd.la",
    "www.fuegocine.com",
    "fuegocine.com",
    "pelispanda.org",
    "tioplus.app",
    "vidhideplus.com",
    "*.vidhideplus.com",
    "callistanise.com",
    "*.callistanise.com"
  ],
  "capabilities": [
    "search",
    "home",
    "browse",
    "episodes",
    "resolve",
    "scopedSearch",
    "download"
  ],
  "streamHosts": "any",
  "categories": [
    "movies",
    "series"
  ],
  "color": "#C62828",
  "section": {
    "label": "Latino",
    "labelEn": "Latino"
  },
  "theme": {
    "accent": "#BA2D2A",
    "onAccent": "#FFFFFF",
    "background": "#0B0707",
    "surface": "#1A1212",
    "highlight": "#F4C7C3"
  },
  "browser": true,
  "telemetry": true,
  "settings": [
    {
      "key": "langSection",
      "type": "section",
      "label": "Idioma y calidad",
      "labelEn": "Language and quality",
      "hint": "Qué copia se abre primero cuando un título tiene varias.",
      "hintEn": "Which copy opens first when a title has several."
    },
    {
      "key": "preferred",
      "type": "select",
      "label": "Idioma preferido",
      "labelEn": "Preferred language",
      "default": "lat",
      "options": [
        {
          "value": "lat",
          "label": "Latino",
          "labelEn": "Latin Spanish"
        },
        {
          "value": "esp",
          "label": "Castellano",
          "labelEn": "Spain Spanish"
        },
        {
          "value": "sub",
          "label": "Subtitulado",
          "labelEn": "Subtitled"
        }
      ],
      "hint": "Lo que cambies en el panel manda hasta que uses Restablecer allí.",
      "hintEn": "Set in the player panel, it wins until you use Reset there."
    },
    {
      "key": "maxQuality",
      "type": "select",
      "label": "Calidad máxima",
      "labelEn": "Maximum quality",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "Automática",
          "labelEn": "Automatic"
        },
        {
          "value": "1080p",
          "label": "Hasta 1080p",
          "labelEn": "Up to 1080p"
        },
        {
          "value": "720p",
          "label": "Hasta 720p",
          "labelEn": "Up to 720p"
        },
        {
          "value": "480p",
          "label": "Hasta 480p (ahorra datos)",
          "labelEn": "Up to 480p (saves data)"
        }
      ],
      "hint": "Lo que cambies en el panel manda hasta que uses Restablecer allí.",
      "hintEn": "Set in the player panel, it wins until you use Reset there."
    },
    {
      "key": "srcSection",
      "type": "section",
      "label": "Fuentes",
      "labelEn": "Sources",
      "hint": "Apaga una fuente si te da problemas.",
      "hintEn": "Turn a source off if it gives you trouble."
    },
    {
      "key": "src_lamovie",
      "type": "toggle",
      "label": "LaMovie",
      "labelEn": "LaMovie",
      "default": true
    },
    {
      "key": "src_hackstore",
      "type": "toggle",
      "label": "HackStore",
      "labelEn": "HackStore",
      "default": true
    },
    {
      "key": "src_cinecalidad",
      "type": "toggle",
      "label": "CineCalidad",
      "labelEn": "CineCalidad",
      "default": true
    },
    {
      "key": "src_seriesmetro",
      "type": "toggle",
      "label": "SeriesMetro",
      "labelEn": "SeriesMetro",
      "default": true
    },
    {
      "key": "src_seriesflix",
      "type": "toggle",
      "label": "Seriesflix",
      "labelEn": "Seriesflix",
      "default": true
    },
    {
      "key": "src_embed69",
      "type": "toggle",
      "label": "Embed69",
      "labelEn": "Embed69",
      "default": true
    },
    {
      "key": "src_zoowomaniacos",
      "type": "toggle",
      "label": "Zoowomaniacos",
      "labelEn": "Zoowomaniacos",
      "default": true
    },
    {
      "key": "homeSection",
      "type": "section",
      "label": "Inicio",
      "labelEn": "Home"
    },
    {
      "key": "homeRows",
      "type": "toggle",
      "label": "Filas en Inicio",
      "labelEn": "Rows on Home",
      "default": true,
      "hint": "Muestra los estrenos de Latino en el Inicio de Kino.",
      "hintEn": "Shows Latino's new releases on Kino's Home."
    },
    {
      "key": "toolsSection",
      "type": "section",
      "label": "Estado",
      "labelEn": "Status",
      "hint": "Cada fuente dice si respondió en su última consulta.",
      "hintEn": "Each source says whether it answered its last request."
    },
    {
      "key": "health",
      "type": "status",
      "label": "Fuentes",
      "labelEn": "Sources"
    },
    {
      "key": "probe",
      "type": "action",
      "label": "Probar fuentes ahora",
      "labelEn": "Test the sources now"
    },
    {
      "key": "clearCache",
      "type": "action",
      "label": "Borrar caché",
      "labelEn": "Clear cache"
    },
    {
      "key": "resetPrefs",
      "type": "action",
      "label": "Restablecer preferencias",
      "labelEn": "Reset preferences",
      "confirm": "¿Volver a los valores de fábrica de Latino?",
      "confirmEn": "Go back to Latino's default settings?"
    }
  ]
}
